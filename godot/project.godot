; 并肩山谷 — Godot 4.4 客户端。权威模拟仍在 Node/ws。
config_version=5

[application]

config/name="并肩山谷"
config/description="两部 iPhone，同一座山。Godot 4 客户端进同一间山谷。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.41, 0.25, 0.12, 1)
boot_splash/image="res://assets/art/cover-valley.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

